{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), payment=(), geolocation=(self)"
      },
      "continue": true
    },
    {
      "src": "/nemt-signup",
      "dest": "/nemt-signup.html"
    },
    {
      "src": "/facility-signup",
      "dest": "/facility-signup.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/driver",
      "dest": "/driver.html"
    },
    {
      "src": "/coordinator",
      "dest": "/coordinator.html"
    },
    {
      "src": "/invite",
      "dest": "/invite.html"
    },
    {
      "src": "/patients",
      "dest": "/patients.html"
    },
    {
      "src": "/email-logo-mark.png",
      "dest": "/email-logo-mark.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}