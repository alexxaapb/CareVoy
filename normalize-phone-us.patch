@@ -96,7 +96,16 @@ function escHtml(s) {
     .replace(/'/g, '&#39;');
 }
 
+// Turn a US phone number into +1XXXXXXXXXX for Twilio. Returns '' if it can't be a valid US number.
+function toE164(raw) {
+  var d = String(raw == null ? '' : raw).replace(/\D/g, '');
+  if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
+  if (d.length !== 10) return '';
+  if (d.charAt(0) === '0' || d.charAt(0) === '1') return ''; // area codes never start with 0 or 1
+  return '+1' + d;
+}
+
 module.exports = {
-  adminClient, safeEqual, isInternal, internalHeaders, getCaller,
