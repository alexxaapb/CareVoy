{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" }
  ],
  "functions": {
    "api/rides/update-status.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/receipts/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
