{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" }
  ],
  "crons": [
    { "path": "/api/cron/auto-reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/unassigned-ride-alert", "schedule": "0 * * * *" }
  ]
}
